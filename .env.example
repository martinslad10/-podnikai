# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY / GOOGLE_PLACES_API_KEY:
# Required for real business entity search (Google Places API New).
# Used to fetch real company names, verified addresses, websites, phone numbers, and Google ratings.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Master passcode for PODNIKAI internal Business Start administration.
# Stored strictly server-side.
ADMIN_PASSCODE=

# ADMIN_SESSION_SECRET: Cryptographic secret for signing admin session tokens.
ADMIN_SESSION_SECRET=

# STRIPE_SECRET_KEY: Production Stripe secret key (starts with sk_live_ or rk_live_).
# Required strictly server-side for real Stripe Checkout (1 990 Kč).
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Production Stripe webhook signing secret (starts with whsec_).
# Required strictly server-side for verifying stripe-signature on webhook events.
STRIPE_WEBHOOK_SECRET=

